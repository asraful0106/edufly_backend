// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Institutions Table
model Institutions {
  eiin           String          @id @default(uuid())
  name_eng       String
  name_bng       String
  founding_date  DateTime?
  address        String?
  phone_number   String
  email          String          @unique
  document_proof String?
  logo           String?
  cover_photo    String?
  type           InstitutionType @default(school)
  isVerified     Boolean         @default(false)
  password       String? // Must be hashed in app logic
  longitude      String?
  latitude       String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  // Relations
  teachers           Teachers[]
  students           Students[]
  posts              Posts[]
  notifications      Notifications[]
  courses            Courses[]
  batches            Batches[]
  classes            Classes[]
  examTypes          ExamTypes[]
  results            Results[]
  classTests         ClassTests[]
  resultApprovals    ResultApprovals[] // Added for result approval
  stuedentAttendance StudentAttendance[]
  parents            Parents[]
}

enum InstitutionType {
  school
  college
  school_college // Fixed from school__college
  madrasha
  coaching_center
  primary_school
  others
}

// Notifications Table
model Notifications {
  id             String   @id @default(uuid())
  institution_id String
  title          String
  message        String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  notificationContent NotificationContent[]
  institution         Institutions          @relation(fields: [institution_id], references: [eiin])
}

// Notification Content Table
model NotificationContent {
  id              String   @id @default(uuid())
  notification_id String
  content_link    String
  created_at      DateTime @default(now())

  notification Notifications @relation(fields: [notification_id], references: [id])
}

// Posts Table
model Posts {
  id             String   @id @default(uuid())
  institution_id String
  title          String
  description    String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  images      Images[]
  institution Institutions @relation(fields: [institution_id], references: [eiin])
}

// Images Table
model Images {
  id         String   @id @default(uuid())
  post_id    String
  image_link String
  created_at DateTime @default(now())

  post Posts @relation(fields: [post_id], references: [id])
}

// Courses Table
model Courses {
  id             String   @id @default(uuid())
  institution_id String
  course_code    String   @unique
  title          String
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  classes           Classes[]
  results           Results[]
  classTests        ClassTests[]
  markSegments      CourseMarkSegments[] // Added for mark segments
  studentAttendance StudentAttendance[]
  institution       Institutions         @relation(fields: [institution_id], references: [eiin])
}

// Batches Table
model Batches {
  id             String    @id @default(uuid())
  institution_id String
  batch_code     String    @unique
  starting_date  DateTime?
  ending_date    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  students    Students[]
  institution Institutions @relation(fields: [institution_id], references: [eiin])
}

// Classes Table
model Classes {
  id                    String   @id @default(uuid())
  institution_id        String
  course_id             String
  batch_code            String   @unique
  title                 String?
  description           String?
  start_date            DateTime
  end_date              DateTime
  next_batch            String?  @unique
  homeroom_teacher_id   String?
  class_captain_id      String?
  vice_class_captain_id String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  sections          Sections[]
  students          Students[]
  classTests        ClassTests[]
  studentAttendance StudentAttendance[]
  course            Courses             @relation(fields: [course_id], references: [id])
  institution       Institutions        @relation(fields: [institution_id], references: [eiin])
}

// Sections Table
model Sections {
  id                    String   @id @default(uuid())
  class_id              String
  section_name          String
  homeroom_teacher_id   String?
  class_captain_id      String?
  vice_class_captain_id String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  students          Students[]
  results           Results[]
  classTests        ClassTests[]
  studentAttendance StudentAttendance[]
  class             Classes             @relation(fields: [class_id], references: [id])
}

// Course Mark Segments Table
model CourseMarkSegments {
  id           String   @id @default(uuid())
  course_id    String
  name         String // e.g., "Attendance", "Quizzes", "Mid-Term"
  max_marks    Float // Max score for this segment
  description  String?
  isMainResult Boolean  @default(true) // True = main result, False = class test/practice
  isAveraged   Boolean  @default(false) // True = average multiple results (e.g., quizzes)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  course  Courses   @relation(fields: [course_id], references: [id])
  results Results[]
}

// Exam Types Table
model ExamTypes {
  id             String   @id @default(uuid())
  institution_id String
  name           String // e.g., "Quiz 1", "Mid-Term", "Final"
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  results     Results[]
  institution Institutions @relation(fields: [institution_id], references: [eiin])
}

// Results Table (Main Results)
model Results {
  id              String    @id @default(uuid())
  institution_id  String
  examTypeId      String // Renamed from exam_types_id
  course_id       String?
  section_id      String?
  student_id      String
  teacher_id      String
  mark_segment_id String
  marks           Float
  remarks         String? // Fixed from Float?
  isPublished     Boolean   @default(false)
  published_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  examType    ExamTypes          @relation(fields: [examTypeId], references: [id])
  institution Institutions       @relation(fields: [institution_id], references: [eiin])
  course      Courses?           @relation(fields: [course_id], references: [id])
  section     Sections?          @relation(fields: [section_id], references: [id])
  student     Students           @relation(fields: [student_id], references: [id])
  teacher     Teachers           @relation(fields: [teacher_id], references: [id])
  markSegment CourseMarkSegments @relation(fields: [mark_segment_id], references: [id])
  approvals   ResultApprovals[] // Added for approval workflow
}

// Result Approvals Table (Added)
model ResultApprovals {
  id             String         @id @default(uuid())
  result_id      String
  institution_id String
  status         ApprovalStatus @default(pending)
  requested_at   DateTime       @default(now())
  approved_at    DateTime?
  remarks        String?

  result      Results      @relation(fields: [result_id], references: [id])
  institution Institutions @relation(fields: [institution_id], references: [eiin])
}

// Class Tests Table (Completed)
model ClassTests {
  id             String   @id @default(uuid())
  institution_id String
  course_id      String
  class_id       String?
  section_id     String?
  teacher_id     String
  student_id     String
  full_marks     Float // Max marks for this test
  marks          Float? // Actual marks scored
  title          String // e.g., "Class Test 1"
  remarks        String? // Optional feedback
  created_at     DateTime @default(now()) // Published immediately
  updated_at     DateTime @updatedAt

  institution Institutions @relation(fields: [institution_id], references: [eiin])
  course      Courses      @relation(fields: [course_id], references: [id])
  class       Classes?     @relation(fields: [class_id], references: [id])
  section     Sections?    @relation(fields: [section_id], references: [id])
  teacher     Teachers     @relation(fields: [teacher_id], references: [id])
  student     Students     @relation(fields: [student_id], references: [id])
}

// Teachers Table
model Teachers {
  id               String   @id @default(uuid())
  institution_id   String
  name_eng         String
  name_bng         String
  teacher_id       String
  teacher_initial  String
  fingerprint      Json?
  image            String
  email            String   @unique
  phone_number     String
  password         String
  religion         Religion @default(islam)
  gender           Gender   @default(male)
  date_of_birth    DateTime
  present_adress   String?
  parmanent_adress String?
  signature        String?
  position         String?
  blood_group      String?
  role             Role     @default(teacher)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relation
  results           Results[]
  classTests        ClassTests[]
  studentAttendance StudentAttendance[]
  teacherAttendance TeacherAttendance[]

  // Relationship
  institution Institutions @relation(fields: [institution_id], references: [eiin])
}

// Teacher Attendance Table
model TeacherAttendance {
  id             String           @id @default(uuid())
  institution_id String
  teacher_id     String
  date           DateTime
  status         AttendanceStatus @default(absent) // Present, absent, late, etc.
  remarks        String? // Optional notes (e.g., "Sick")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  // Relation
  teacher Teachers @relation(fields: [teacher_id], references: [id])
}

// Students Table
model Students {
  id               String        @id @default(uuid())
  institution_id   String
  batch_id         String
  class_id         String?
  section_id       String?
  class_roll       String
  name_eng         String
  name_bng         String
  student_id       String
  fingerprint      Json?
  image            String
  email            String        @unique
  phone_number     String
  password         String
  religion         Religion      @default(islam)
  gender           Gender        @default(male)
  date_of_birth    DateTime
  present_adress   String?
  parmanent_adress String?
  signature        String?
  blood_group      String?
  role             Role          @default(student)
  status           StudentStatus @default(current)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  // Relation
  results           Results[]
  classTests        ClassTests[]
  studentAttendance StudentAttendance[]
  parents           Parents[]
  // Realtionship
  institution       Institutions        @relation(fields: [institution_id], references: [eiin])
  batch             Batches             @relation(fields: [batch_id], references: [id])
  class             Classes?            @relation(fields: [class_id], references: [id])
  section           Sections?           @relation(fields: [section_id], references: [id])
}

// Student Attendeance Table
model StudentAttendance {
  id             String           @id @default(uuid())
  institution_id String
  course_id      String?
  class_id       String?
  section_id     String?
  student_id     String
  teacher_id     String
  date           DateTime
  status         AttendanceStatus @default(absent) // Present, absent, late, etc.
  remarks        String? // Optional notes (e.g., "Sick")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  // Relationship
  institution Institutions @relation(fields: [institution_id], references: [eiin])
  student     Students     @relation(fields: [student_id], references: [id])
  teacher     Teachers     @relation(fields: [teacher_id], references: [id])
  course      Courses?     @relation(fields: [course_id], references: [id])
  class       Classes?     @relation(fields: [class_id], references: [id])
  section     Sections?    @relation(fields: [section_id], references: [id])
}

// Parent Information
model Parents {
  id                String  @id @default(uuid())
  institution_id    String
  student_id        String
  father_name       String?
  father_phone      String?
  father_email      String?
  father_id_number  String?
  father_occupotion String?
  mother_name       String?
  mother_phone      String?
  mother_email      String?
  mother_id_number  String?
  mother_occupotion String?

  // Relation
  institution Institutions @relation(fields: [institution_id], references: [eiin])
  student     Students     @relation(fields: [student_id], references: [id])
}

// Enums
enum Religion {
  islam
  hindu
  buddhist
  christian
  others
}

enum Gender {
  male
  female
  others
}

enum Role {
  student
  teacher
  admin
}

enum StudentStatus {
  current
  alumni
  dropout
  rusticated
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum AttendanceStatus {
  present
  absent
  late
  leave
}
